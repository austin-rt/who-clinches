# ── Simulator (required) ──────────────────────────────────────────────
# CFBD API — comma-separate multiple keys for rotation in non-prod
CFBD_API_KEY=your_cfbd_api_key

# ── Share Links / AI Chat / RAG ──────────────────────────────────────
# Neon Postgres — pooled connection (PgBouncer) for app runtime
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/dbname?sslmode=require&pgbouncer=true
# Neon Postgres — unpooled (direct) connection for Prisma migrations
DIRECT_URL=postgresql://user:password@your-neon-host.neon.tech/dbname?sslmode=require

# ── AI Chat ──────────────────────────────────────────────────────────
# Anthropic Haiku 4.5 — powers the AI analyst
ANTHROPIC_API_KEY=your_anthropic_api_key
# HMAC signing key for anonymous chat cookies (random 32-char string)
CHAT_IDENTITY_SECRET=your_random_32_char_string

# ── RAG (requires Neon DB above) ─────────────────────────────────────
# Voyage AI — generates embeddings for the knowledge base
VOYAGE_API_KEY=your_voyage_api_key

# ── Caching / Rate Limiting ──────────────────────────────────────────
# Upstash Redis — optional in dev, always-on in prod
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ── Alerts ───────────────────────────────────────────────────────────
# Resend — magic link emails for donors + admin notifications
RESEND_API_KEY=your_resend_api_key
# Admin notification recipient (default: whoclinches@austinrt.com)
RESEND_ADMIN_EMAIL=you@example.com

# ── Donations ────────────────────────────────────────────────────────
# Buy Me a Coffee — HMAC verification for donation webhooks
BMC_WEBHOOK_SECRET=your_bmc_webhook_secret

# ── Vercel (prod/preview only) ───────────────────────────────────────
# Cron job auth
CRON_SECRET=your_cron_secret
# Preview auth bypass + rate limit bypass for Playwright tests
VERCEL_AUTOMATION_BYPASS_SECRET=your_vercel_bypass_secret
